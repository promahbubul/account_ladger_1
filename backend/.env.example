# Server Port
PORT=5001
NODE_ENV=development

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5000

# PostgreSQL Connection Strings
# Pooled connection string (used by app runtime):
DATABASE_URL=postgresql://user:password@localhost:5432/hisabflow?sslmode=disable
# Direct connection string (optional, used for migrations):
DIRECT_URL=postgresql://user:password@localhost:5432/hisabflow?sslmode=disable

# JWT Secret for server-side authorization tokens
JWT_SECRET=hisabflow-secure-jwt-secret-key-neon-db

# Initial System Credentials (used on first bootstrap)
ADMIN_INITIAL_PASSWORD=Mahbub@12345
USER_INITIAL_PASSWORD=User@12345

# Firebase Admin Configuration (Server-Side Only - Never expose to frontend)
FIREBASE_PROJECT_ID=account-ladger01
# Preferred: GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
# Alternative: FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# Alternative: FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@account-ladger01.iam.gserviceaccount.com
# Alternative: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-dedicated-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=your-dedicated-email@gmail.com
APP_NAME=AccountLedger

