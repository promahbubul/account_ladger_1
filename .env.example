# GEMINI_API_KEY: Injected by AI Studio if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Neon PostgreSQL Database Connections
# Provide your Neon connection strings below:
# Pooled connection string (used by app runtime):
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (optional, used for migrations):
DIRECT_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Initial Administrator Credentials
# Initial password for default admin account (mahbub / mahbub@gmail.com)
ADMIN_INITIAL_PASSWORD="Mahbub@12345"

# JWT Secret for server-side authorization tokens
JWT_SECRET="hisabflow-secure-jwt-secret-key-neon-db"

# Server Port (default 3000)
PORT="3000"
