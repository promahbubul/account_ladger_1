{
  "name": "accountledger",
  "version": "2.0.0",
  "private": true,
  "description": "AccountLedger.com — Personal Accounting Ledger & Money Manager",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "seed:backend": "npm --prefix backend run seed",
    "prisma:generate": "npm --prefix backend run prisma:generate"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
