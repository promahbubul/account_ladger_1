{
  "name": "accountledger",
  "version": "2.0.0",
  "private": true,
  "description": "AccountLedger.com — Personal Accounting Ledger & Money Manager",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test:mobile": "npm --prefix mobile test",
    "test:e2e": "playwright test",
    "seed:backend": "npm --prefix backend run seed",
    "lint": "eslint .",
    "prisma:generate": "npm --prefix backend run prisma:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
